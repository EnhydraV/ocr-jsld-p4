{
  "all": true,
  "include": ["src/**/*.{ts,tsx}"],
  "exclude": [
    "src/**/*.test.{ts,tsx}",
    "src/test/**",
    "src/main.tsx",
    "src/types/**",
    "src/**/*.d.ts"
  ],
  "reporter": ["text", "text-summary", "html", "lcov"],
  "report-dir": "coverage-e2e",
  "check-coverage": true,
  "statements": 80,
  "branches": 80,
  "functions": 80,
  "lines": 80
}
